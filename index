html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>提现限制提示 - 加盟商后台</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://unpkg.com/lucide@latest/dist/umd/lucide.min.js"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        primary: '#2563EB',
                        secondary: '#3B82F6',
                        cta: '#F97316',
                        background: '#F8FAFC',
                        text: '#1E293B',
                        danger: '#EF4444',
                        warning: '#F59E0B',
                        success: '#10B981'
                    },
                    fontFamily: {
                        inter: ['Inter', 'sans-serif'],
                    },
                    boxShadow: {
                        'glass': '0 8px 32px 0 rgba(31, 38, 135, 0.15)',
                        'card': '0 4px 20px rgba(0, 0, 0, 0.05)',
                        'button': '0 4px 12px rgba(37, 99, 235, 0.25)',
                    },
                    backdropBlur: {
                        'md': '12px',
                    }
                }
            }
        }
    </script>
    <style type="text/tailwindcss">
        @layer utilities {
            .content-auto {
                content-visibility: auto;
            }
            .glass {
                background: rgba(255, 255, 255, 0.9);
                backdrop-filter: blur(12px);
                border: 1px solid rgba(255, 255, 255, 0.2);
            }
            .text-balance {
                text-wrap: balance;
            }
        }
    </style>
</head>
<body class="bg-background font-inter text-text min-h-screen flex items-center justify-center">
    <!-- 后台背景模拟 -->
    <div class="w-full max-w-5xl bg-white rounded-2xl shadow-card p-8">
        <div class="flex justify-between items-center mb-8">
            <div>
                <h1 class="text-[clamp(1.5rem,3vw,2rem)] font-bold text-text mb-1">钱包管理</h1>
                <p class="text-gray-500">管理您的资金收入与提现</p>
            </div>
            <div class="text-right">
                <p class="text-gray-500 text-sm">可用余额</p>
                <p class="text-3xl font-bold text-primary">¥24,560.00</p>
            </div>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
            <div class="bg-gradient-to-br from-green-50 to-green-100 rounded-xl p-6 border border-green-200/50 hover:shadow-lg transition-all duration-300 transform hover:-translate-y-1">
                <div class="flex items-center justify-between mb-3">
                    <p class="text-green-700 font-medium">今日收入</p>
                    <div class="w-10 h-10 rounded-full bg-green-500/10 flex items-center justify-center">
                        <i class="fa fa-arrow-up text-green-600"></i>
                    </div>
                </div>
                <p class="text-3xl font-bold text-green-800">¥3,240.00</p>
                <p class="text-green-600 text-sm mt-2">↑ 12.5% 较昨日</p>
            </div>
            <div class="bg-gradient-to-br from-blue-50 to-blue-100 rounded-xl p-6 border border-blue-200/50 hover:shadow-lg transition-all duration-300 transform hover:-translate-y-1">
                <div class="flex items-center justify-between mb-3">
                    <p class="text-blue-700 font-medium">本月总收入</p>
                    <div class="w-10 h-10 rounded-full bg-blue-500/10 flex items-center justify-center">
                        <i class="fa fa-calendar text-blue-600"></i>
                    </div>
                </div>
                <p class="text-3xl font-bold text-blue-800">¥68,920.00</p>
                <p class="text-blue-600 text-sm mt-2">↑ 8.2% 较上月</p>
            </div>
            <div class="bg-gradient-to-br from-gray-50 to-gray-100 rounded-xl p-6 border border-gray-200/50 hover:shadow-lg transition-all duration-300 transform hover:-translate-y-1">
                <div class="flex items-center justify-between mb-3">
                    <p class="text-gray-700 font-medium">待结算</p>
                    <div class="w-10 h-10 rounded-full bg-gray-500/10 flex items-center justify-center">
                        <i class="fa fa-clock-o text-gray-600"></i>
                    </div>
                </div>
                <p class="text-3xl font-bold text-gray-800">¥12,380.00</p>
                <p class="text-gray-600 text-sm mt-2">预计 T+2 到账</p>
            </div>
        </div>
        <button class="bg-primary hover:bg-primary/90 text-white px-8 py-4 rounded-xl font-semibold transition-all duration-300 hover:shadow-button transform hover:-translate-y-0.5 flex items-center cursor-pointer" id="withdrawBtn">
            <i class="fa fa-money mr-3 text-lg"></i> 
            <span>申请提现</span>
        </button>
    </div>

    <!-- 提现失败弹窗 -->
    <div class="fixed inset-0 flex items-center justify-center z-50 bg-black/40 backdrop-blur-sm" id="modal">
        <div class="glass rounded-2xl shadow-glass w-full max-w-lg transform transition-all duration-300 scale-100 animate-[fadeIn_0.3s_ease-out]">
            <div class="p-8">
                <div class="flex items-center mb-6">
                    <div class="w-12 h-12 rounded-full bg-red-100 flex items-center justify-center mr-4 flex-shrink-0">
                        <i class="fa fa-exclamation-triangle text-danger text-xl"></i>
                    </div>
                    <div>
                        <h2 class="text-xl font-bold text-text mb-1">提现申请失败</h2>
                        <p class="text-gray-500 text-sm">您的账户存在未结清账单，请先完成支付</p>
                    </div>
                </div>
                <p class="text-gray-700 mb-6 leading-relaxed text-balance">
                    您有未结清的平台服务费账单，请先完成所有账单支付后再发起提现申请。
                </p>
                <div class="bg-orange-50 border border-orange-200/60 rounded-xl p-5 mb-8">
                    <div class="flex items-start">
                        <i class="fa fa-info-circle text-warning mr-3 text-lg mt-0.5"></i>
                        <div>
                            <p class="text-orange-800 font-medium mb-1">未结清账单信息</p>
                            <p class="text-orange-900 text-2xl font-bold">¥12,450.00</p>
                            <p class="text-orange-700 text-sm mt-1">共2笔待支付账单</p>
                        </div>
                    </div>
                </div>
                <div class="flex justify-end space-x-4">
                    <button class="px-6 py-3 border border-gray-300 rounded-xl text-gray-700 hover:bg-gray-50 transition-all duration-200 font-medium cursor-pointer" id="cancelBtn">
                        取消
                    </button>
                    <button class="px-6 py-3 bg-primary hover:bg-primary/90 text-white rounded-xl font-semibold transition-all duration-300 hover:shadow-button transform hover:-translate-y-0.5 flex items-center cursor-pointer">
                        <span>去支付账单</span>
                        <i class="fa fa-arrow-right ml-2"></i>
                    </button>
                </div>
            </div>
        </div>
    </div>

    <script>
        lucide.createIcons();
        
        document.getElementById('withdrawBtn').addEventListener('click', () => {
            document.getElementById('modal').classList.remove('hidden');
        });
        
        document.getElementById('cancelBtn').addEventListener('click', () => {
            document.getElementById('modal').classList.add('hidden');
        });
    </script>
</body>
</html>
